# DAH API 서버 환경변수 (12_BACKEND.md). 실제 값은 .env에 두고 커밋 금지(.gitignore 처리됨).
# 이관 시: 아래 값만 새 계정/프로젝트 기준으로 교체하면 됨(코드 수정 불필요).

# ── 필수 ──
# Neon Postgres 연결 문자열 — 신규 조직/프로젝트의 값으로 교체
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# JWT 서명 키 — 길고 임의의 문자열(이관 시 새로 생성 권장). 바꾸면 기존 로그인 세션 무효화
JWT_SECRET=change-me-to-a-long-random-string
# Vercel Blob 읽기/쓰기 토큰(계획상 당분간 현 계정 유지 가능). 미설정 시 로컬 uploads/ 폴백(개발용)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Google Drive 파일 업로드(선택) — 일반 "내 드라이브" 권장 설정.
# 학교 Google 계정으로 승인받은 OAuth 클라이언트와 refresh token을 Render 서버에만 저장.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Google Workspace 공유 드라이브를 쓰는 경우에만 아래 서비스 계정 모드를 사용.
GOOGLE_DRIVE_AUTH_MODE=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# 프론트(Vercel) 오리진 — CORS 화이트리스트. 여러 개면 쉼표 구분.
#   로컬=http://localhost:5173, 배포=정확한 Vercel 도메인(https://<your-frontend>.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# ── 배포(Render)에서만 ──
# 반드시 production 으로 설정해야 Secure·SameSite=None 쿠키가 켜져 크로스사이트 로그인이 동작.
# 로컬 개발에서는 설정하지 말 것(http localhost에서 Secure 쿠키는 저장 안 됨).
# NODE_ENV=production
# 포트 — Render가 자동 주입하므로 배포에선 설정 불필요. 로컬 개발용 기본값.
PORT=4000

# ── 시드/운영 ──
# 시드 시 owner 계정 이메일 (must_set_pw=true 등록 → 최초 로그인에서 비밀번호 설정)
OWNER_EMAIL=owner@example.com
# DB 백업(export) 파일 기록 경로 (server/ 기준 상대 또는 절대. 기본 ../client/src/data/snapshot)
EXPORT_DIR=../client/src/data/snapshot

# ── 공개 제출자 구글 로그인 (41_GOOGLE_AUTH_PUBLIC) ──
# 셋 다 있어야 /auth/google/login이 동작한다. 없으면 503 + 안내 JSON(사이트 나머지는 정상).
# Google Cloud 콘솔 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)에서 발급.
# 승인된 리디렉션 URI는 GOOGLE_REDIRECT_URI와 문자 단위로 같아야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── 선택: 상담 알림 + 접수 확인 메일 (없으면 알림만 스킵, DB 저장은 항상 수행) ──
# 이메일(Nodemailer SMTP) — SMTP_HOST·SMTP_USER·SMTP_PASS·CONSULT_NOTIFY_TO 4개 전부 있어야 발송
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONSULT_NOTIFY_TO=
# 발신자 표기 — 미설정 시 SMTP_USER를 그대로 쓴다. 전시회 접수 확인 메일에도 사용.
MAIL_FROM=
# 텔레그램 — TELEGRAM_BOT_TOKEN·TELEGRAM_CHAT_ID 둘 다 있어야 발송
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
