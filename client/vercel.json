{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|bingbot|BingPreview|msnbot|Yeti|NaverBot|Naverbot|Daumoa|Daum|kakaotalk|KAKAOTALK|facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|Discordbot|TelegramBot|WhatsApp|Applebot|DuckDuckBot|Zumbot|PetalBot|Embedly|Pinterestbot|SkypeUriPreview|Slurp).*"
        }
      ],
      "destination": "https://dah-website-72a4.onrender.com/seo/page?path=/"
    },
    {
      "source": "/:path((?:about|curriculum|programs|students|showcase|news|resources|privacy|terms)(?:/.*)?)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|AdsBot-Google|bingbot|BingPreview|msnbot|Yeti|NaverBot|Naverbot|Daumoa|Daum|kakaotalk|KAKAOTALK|facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|Discordbot|TelegramBot|WhatsApp|Applebot|DuckDuckBot|Zumbot|PetalBot|Embedly|Pinterestbot|SkypeUriPreview|Slurp).*"
        }
      ],
      "destination": "https://dah-website-72a4.onrender.com/seo/page?path=/:path"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dah-website-72a4.onrender.com/:path*"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://dah-website-72a4.onrender.com/mcp/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://dah-website-72a4.onrender.com/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "https://dah-website-72a4.onrender.com/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://dah-website-72a4.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "https://dah-website-72a4.onrender.com/.well-known/oauth-authorization-server/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://dah-website-72a4.onrender.com/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration/:path*",
      "destination": "https://dah-website-72a4.onrender.com/.well-known/openid-configuration/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
